{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoadCreator",
  "version": "2.0.0",
  "identifier": "com.loadcreator.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "LoadCreator · FEM 载荷表格转换器",
      "width": 1440,
      "height": 920,
      "minWidth": 420,
      "minHeight": 560,
      "resizable": true,
      "center": true
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LoadCreator",
    "copyright": "LoadCreator",
    "category": "DeveloperTool",
    "shortDescription": "FEM 载荷表格转换器",
    "longDescription": "离线解析 Excel/WPS 粘贴表格，按点位名称生成 FEM 与节点 JSON。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "hooks.nsh"
      }
    }
  }
}
